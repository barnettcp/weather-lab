[Unit]
Description=Fetch NWS actual observations
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=YOUR_USERNAME
WorkingDirectory=/path/to/your/weather-lab
ExecStart=/path/to/your/weather-lab/venv/bin/python fetch_actuals.py
StandardOutput=append:/path/to/your/weather-lab/logs/actuals.log
StandardError=append:/path/to/your/weather-lab/logs/actuals.log
